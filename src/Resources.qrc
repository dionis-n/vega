<RCC>
    <qresource prefix="/">
        <file alias="light_theme.qss">Resources/Styles/light_theme.qss</file>
        <file alias="dark_theme.qss">Resources/Styles/dark_theme.qss</file>
        <file>Resources/VegaIcon/Vega.ico</file>
        <file>Resources/VegaIcon/manifest.json</file>
        <file>Resources/VegaIcon/service-worker.js</file>
        <file>Resources/VegaIcon/icon-192.png</file>
        <file>Resources/VegaIcon/screenshot-desktop.png</file>
        <file>Resources/VegaIcon/screenshot-mobile.png</file>
        <file>Resources/VegaIcon/icon-144.png</file>
        <file>Resources/VegaIcon/icon-512.png</file>
    </qresource>
    <qresource prefix="/Icons/Light">
        <file>Resources/Icons/Light/settings_fill.svg</file>
        <file>Resources/Icons/Light/settings.svg</file>
        <file>Resources/Icons/Light/schedule_fill.svg</file>
        <file>Resources/Icons/Light/schedule.svg</file>
    </qresource>
    <qresource prefix="/Icons/Dark">
        <file>Resources/Icons/Dark/settings_fill.svg</file>
        <file>Resources/Icons/Dark/settings.svg</file>
        <file>Resources/Icons/Dark/schedule_fill.svg</file>
        <file>Resources/Icons/Dark/schedule.svg</file>
    </qresource>
</RCC>
